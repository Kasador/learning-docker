{% extends "layouts/main.html.twig" %}

{% block page_title %}Stars{% endblock %}

{% block main %}
<h1 id="home_title">All Stars</h1>

<ul>
    {% for star in stars %}
    <li># {{ star.id}} - {{ star.name}}
        <a href="/stars/{{ star.id }}/edit">Edit</a>
        <a href="/stars/{{ star.id }}/delete">Delete</a>
        <a href="/stars/{{ star.id }}/">View</a>
    </li>
    {% endfor %}
</ul>

<button>
    <a href="/stars/new">Add a Star</a>
</button>
{% endblock %}