{% extends "layouts/main.html.twig" %}

{% block page_title %}Galaxies{% endblock %}

{% block main %}
<h1 id="home_title">All Galaxies</h1>

<ul>
    {% for galaxy in galaxies %}
    <li># {{ galaxy.id}} - {{ galaxy.name}}
        <a href="/galaxies/{{ galaxy.id }}/edit">Edit</a>
        <a href="/galaxies/{{ galaxy.id }}/delete">Delete</a>
        <a href="/galaxies/{{ galaxy.id }}/">View</a>
    </li>
    {% endfor %}
</ul>

<button>
    <a href="/galaxies/new">Add a galaxies</a>
</button>
{% endblock %}