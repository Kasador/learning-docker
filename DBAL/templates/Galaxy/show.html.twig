{% extends "layouts/main.html.twig" %}

{% block page_title %}Galaxy Details{% endblock %}

{% block main %}
    <h1>Galaxy Details</h1>
    
    <div class="galaxy-details">
        <h2>{{ data.name }}</h2>
        
        <div class="detail-row">
            <strong>ID:</strong> {{ data.id }}
        </div>
        
        <div class="detail-row">
            <strong>Name:</strong> {{ data.name }}
        </div>
        
        <div class="detail-row">
            <strong>Size:</strong> {{ data.size }}
        </div>
        
        <div class="detail-row">
            <strong>Description:</strong> {{ data.description }}
        </div>
    </div>

    <div class="actions">
        <a href="/galaxies/{{ data.id }}/edit">Edit Galaxy</a>
        <a href="/galaxies/{{ data.id }}/delete">Delete Galaxy</a>
        <a href="/galaxies">Back to All Galaxies</a>
    </div>

{% endblock %}