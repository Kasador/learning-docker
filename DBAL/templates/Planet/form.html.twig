{% extends "layouts/main.html.twig" %}

{% block main %}
    {% if data.id is not empty %}
        <h1>Editing Details For #{{ data.id }}</h1>
        <form action="/planets/{{ data.id }}" method="POST">
    {% else %}
        <h1>Creating New Planet</h1>
        <form action="/planets" method="POST">
    {% endif %}

            <div>
                <label>Name:</label>
                <input type="text" name="name" value="{{ data.name }}" required />
            </div>

            <div>
                <label>Size:</label>
                <input type="number" name="size" value="{{ data.size }}" required />
            </div>

            <div>
                <label>Description:</label>
                <textarea name="description" required>{{ data.description }}</textarea>
            </div>

            <div>
                <button type="submit">
                    {% if data.id is not empty %}
                        Update Planet
                    {% else %}
                        Create Planet
                    {% endif %}
                </button>
            </div>
        </form>

    {% if data.id is not empty %}
        <div>
            <a href="/planets/">Cancel</a>
        </div>
    {% else %}
        <div>
            <a href="/planets">Cancel</a>
        </div>
    {% endif %}

{% endblock %}