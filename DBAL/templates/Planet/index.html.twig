{% extends "layouts/main.html.twig" %}

{% block page_title %}Planets{% endblock %}

{% block main %}
<h1 id="home_title">All Planets</h1>

<ul>
    {% for planet in planets %}
    <li># {{ planet.id}} - {{ planet.name}}
        <a href="/planets/{{ planet.id }}/edit">Edit</a>
        <a href="/planets/{{ planet.id }}/delete">Delete</a>
        <a href="/planets/{{ planet.id }}/">View</a>
    </li>
    {% endfor %}
</ul>

<button>
    <a href="/planets/new">Add a planet</a>
</button>
{% endblock %}