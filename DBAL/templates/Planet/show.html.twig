{% extends "layouts/main.html.twig" %}

{% block page_title %}Planet Details{% endblock %}

{% block main %}
    <h1>Planet Details</h1>
    
    <div class="planet-details">
        <h2>{{ data.name }}</h2>
        
        <div class="detail-row">
            <strong>ID:</strong> {{ data.id }}
        </div>
        
        <div class="detail-row">
            <strong>Name:</strong> {{ data.name }}
        </div>
        
        <div class="detail-row">
            <strong>Size:</strong> {{ data.size }}
        </div>
        
        <div class="detail-row">
            <strong>Description:</strong> {{ data.description }}
        </div>
    </div>

    <div class="actions">
        <a href="/planets/{{ data.id }}/edit">Edit Planet</a>
        <a href="/planets/{{ data.id }}/delete">Delete Planet</a>
        <a href="/planets">Back to All Planets</a>
    </div>

{% endblock %}